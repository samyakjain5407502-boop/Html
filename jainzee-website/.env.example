# Copy to .env (or set in your hosting dashboard) and fill in real values.
# NEVER commit real values to git.

# REQUIRED in production - session/JWT signing key
SECRET_KEY=replace-with-a-long-random-hex-string

# REQUIRED - admin panel password
ADMIN_PASSWORD=replace-with-a-strong-password

# OPTIONAL in production - PostgreSQL connection string
# When set, the app uses PostgreSQL. Leave unset for local SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# OPTIONAL in production - Vercel Blob read-write token for media uploads.
# When set, uploaded logos/product images (and videos) are stored in Vercel
# Blob instead of the local static/uploads folder. REQUIRED on Vercel, whose
# filesystem is read-only. Vercel adds this automatically when a Blob store is
# linked to the project.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Optional overrides
# JAINZEE_DB_PATH=/path/to/jainzee.db
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PORT=5000
